{
  "name": "notion-backup-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.{ts,vue,css}\"",
    "lint:check": "eslint src && prettier --check \"src/**/*.{ts,vue,css}\"",
    "prepare": "simple-git-hooks",
    "check": "vue-tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@unocss/preset-uno": "^66.7.4",
    "@unocss/transformer-directives": "^66.7.4",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "pinia": "^3.0.4",
    "unocss": "^66.7.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-vue": "^9.28.0",
    "lint-staged": "^17.2.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,vue-tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/lint-staged && node_modules/.bin/vue-tsc --noEmit",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "packageManager": "pnpm@11.5.0"
}
