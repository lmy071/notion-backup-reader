{
  "name": "notion-backup-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint:fix": "eslint src --fix && prettier --write \"src/**/*.{ts,vue,css}\"",
    "lint:check": "eslint src && prettier --check \"src/**/*.{ts,vue,css}\"",
    "prepare": "simple-git-hooks",
    "check": "vue-tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@unocss/preset-uno": "^66.8.0",
    "@unocss/transformer-directives": "^66.8.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "katex": "^0.18.4",
    "pinia": "^4.0.3",
    "unocss": "^66.8.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "17.11.0",
    "lint-staged": "^15.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.10"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,vue-tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/lint-staged && node_modules/.bin/vue-tsc --noEmit",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "packageManager": "pnpm@11.5.0"
}
